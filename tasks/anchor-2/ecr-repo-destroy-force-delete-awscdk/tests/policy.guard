# Hand-authored -- NOT a generator stub; emit_oracles() never overwrites it
# (specs/SCHEMA.md §8.2 rule 7). Intent:
# oracles/ecr-repo-destroy-force-delete/intent.md. A generated
# tests/static_tiers.sh fails tier 1 iff any rule below FAILs against the
# awscdk arm's cdk.out/ScenarioStack.template.json.
#
# NO REGO COUNTERPART, and the asymmetry is the scenario: the Terraform-shaped
# arms grade "removing this configuration leaves the account clean" with the
# agent's own destroy (verifier.teardown, gating; specs/SCHEMA.md §5.2). Here
# the destroy cannot decide it -- CDK's default removal policy is Retain, under
# which `cdk destroy --force` exits 0 and leaves the repository in the account
# -- so the template is the only place the mistake is visible.
#
# no_auto_delete_images_custom_resource refuses the deprecated
# `autoDeleteImages`, which meets the same requirement by deploying a Lambda, a
# role and a policy -- equal strictness, same intent clause: natively, not by
# adding resources. It tests Type per resource because a filter matching
# nothing resolves to no values and reports nothing rather than passing.
# repository_exists is fail-closed cover for repository_empties_on_delete,
# whose `when` clause skips a template holding no repository at all.

let repositories = Resources.*[ Type == "AWS::ECR::Repository" ]

rule repository_exists {
	%repositories !empty
}

rule repository_empties_on_delete when %repositories !empty {
	%repositories {
		Properties.EmptyOnDelete == true
	}
}

rule no_auto_delete_images_custom_resource {
	Resources.* {
		Type != "Custom::ECRAutoDeleteImages"
	}
}
