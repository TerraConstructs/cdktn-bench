// Terraform CLI config baked into the image (TF_CLI_CONFIG_FILE points here).
//
// Only method is filesystem_mirror: every provider Terraform needs must come
// from the pre-warmed mirror at /opt/terraform-plugin-mirror, populated at
// image-build time by `terraform providers mirror`. There is deliberately no
// `direct {}` block, so there is no network fallback — a provider missing
// from the mirror fails loudly (unresolvable provider) instead of silently
// phoning home. This is what makes `terraform init` + `terraform validate`
// airtight offline: pass `--network none` to `docker run` and they still
// succeed. Byte-for-byte the same contract as arms/hcl-raw/environment/terraformrc.
provider_installation {
  filesystem_mirror {
    path = "/opt/terraform-plugin-mirror"
  }
}

disable_checkpoint = true
