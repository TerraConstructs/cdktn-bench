// Terraform CLI config baked into the image (TF_CLI_CONFIG_FILE points here).
// Two blocks: where providers come from, and where MODULES come from — the
// second is what this arm adds over arms/hcl-raw/environment/terraformrc.

// The `host` block is what makes `source = "terraform-aws-modules/s3-bucket/aws"`
// resolve offline. Terraform reads the `modules.v1` service straight out of it,
// so it issues no `/.well-known/terraform.json` discovery request and never
// resolves registry.terraform.io in DNS: the module registry is the sidecar and
// nothing else, whatever the container's network policy happens to be
// (DECISIONS.md Amendment 46 (a) the sidecar-is-the-arm-image decision and (g)
// allow_internet stays at Harbor's default;
// ../../../docs/design/tf-module-registry-loopback.md).
//
// `tf-registry` is the compose service name of that sidecar (./docker-compose.yaml).
// The URL is static, so anything that is not a compose project — the in-image
// ./preflight.sh, and the host gates in gates/tf_registry.py — substitutes
// 127.0.0.1 into a copy of this file rather than editing it.
//
// `providers.v1` is restated because a `host` block REPLACES the whole service
// map rather than overriding one entry: omit it and Terraform reports
// "registry.terraform.io does not offer a Terraform provider registry" as soon as
// anything consults the host's services. Nothing here does — the block below
// installs providers from a filesystem mirror, which performs no registry
// discovery — but the restatement keeps a future failure diagnosable and keeps
// this host block identical to the one gates/tf_registry.py writes.
host "registry.terraform.io" {
  services = {
    "modules.v1"   = "http://tf-registry:8081/v1/modules/"
    "providers.v1" = "https://registry.terraform.io/v1/providers/"
  }
}

// Byte-identical to arms/hcl-raw's: every provider must come from the pre-warmed
// mirror at /opt/terraform-plugin-mirror, and there is deliberately no `direct {}`
// block, so a provider missing from the mirror fails loudly instead of silently
// phoning home.
provider_installation {
  filesystem_mirror {
    path = "/opt/terraform-plugin-mirror"
  }
}

disable_checkpoint = true
