# Node / CDK arms
node_modules/
cdk.out/
# cdktn/cdktf synth output (the terraconstructs arm's `cdk.out/` equivalent).
# Produced on the HOST too, not just in-container, whenever anyone runs the
# arm's own `cdktn synth` from arms/terraconstructs/environment/app/.
cdktf.out/

# Terraform arms
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfplan

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Build output
dist/
build/

# aws-bench local run artifacts (jobs are created wherever `aws-bench run` is invoked)
jobs/

# gates/oracle_falsifiability.py's per-arm offline provider-mirror cache
# (extracted from cdktn-bench/<arm>:dev via `docker cp` -- see
# _arm_mirror_provider_versions's own docstring). Regenerated on demand,
# never hand-edited, safe to delete at any time.
.cache/

# uv.lock IS tracked (do not ignore) — kept for reproducible dependency pins.

# offline-proof / solve.sh byproducts in task workspaces (never commit)
cdk.out.rev*/
**/environment/workspace/bin/*.js
**/environment/workspace/outputs.rev*.json

# tsc emit artifacts in the TS arms' workspaces. Both graded arms now run
# `npx tsc -p tsconfig.json && node <emitted>.js` as their synth app command
# (docs/ts-runtime-spike2-results.md), and neither tsconfig sets an outDir, so
# the compiler emits .js/.d.ts NEXT TO the tracked sources. Listed file-by-file
# rather than as a blanket `*.js` because arms/terraconstructs/environment/app/
# mock-sts.js is a TRACKED source file living in the same directory.
**/environment/workspace/lib/*.js
**/environment/workspace/lib/*.d.ts
**/environment/workspace/bin/*.d.ts
**/environment/app/main.js
**/environment/app/main.d.ts
**/environment/app/lib/*.js
**/environment/app/lib/*.d.ts
*.tsbuildinfo

# Operational env-setup/reset run records. The eight dirs tracked before
# 2026-08-20 remain in git as amendment evidence (Amdts 17/18/21/22 cite
# their deploy/reset logs); everything newer is local-only noise.
scenario-jobs/

# Agent worktrees and session scratch (never committed)
.claude/
